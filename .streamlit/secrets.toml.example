# =====================================================================
# CONTOH SECRETS — salin menjadi `.streamlit/secrets.toml` (lokal) atau
# tempel ke Streamlit Community Cloud → App → Settings → Secrets.
# JANGAN commit file secrets.toml asli ke GitHub (sudah ada di .gitignore).
# =====================================================================

# --- WAJIB -------------------------------------------------------------
# Supabase → Connect → "Session pooler" (IPv4, port 5432). Ganti [YOUR-PASSWORD].
DATABASE_URL = "postgresql://postgres.xxxxxxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require"

# Hasil dari: python scripts/generate_admin_secrets.py
ADMIN_PIN_HASH = "pbkdf2_sha256$390000$...$..."
APP_SECRET = "isi-dengan-64-karakter-acak-dari-script"

# --- DISARANKAN ---------------------------------------------------------
# Lapisan kedua Admin Mode: kunci akses panjang (token acak). Bila diisi, admin
# wajib memasukkan PIN + kunci ini. Bisa dibuka via tautan rahasia:
#   https://NAMA-APP.streamlit.app/?ak=<ADMIN_ACCESS_KEY>
# (kunci langsung dihapus dari URL setelah dibaca).
ADMIN_ACCESS_KEY = ""

APP_URL = "https://nama-aplikasi-anda.streamlit.app"
ADMIN_SESSION_TIMEOUT_MINUTES = 30
ADMIN_SESSION_MAX_HOURS = 12

# --- OPSIONAL: notifikasi gratis ke Ketua Panitia -------------------------
# Email via Gmail (buat App Password: myaccount.google.com/apppasswords)
# ADMIN_EMAIL = "ketua@example.com"
# SMTP_HOST = "smtp.gmail.com"
# SMTP_PORT = 587
# SMTP_USER = "akun.pengirim@gmail.com"
# SMTP_PASSWORD = "app-password-16-karakter"
# SMTP_SENDER = "Kalender Panitia <akun.pengirim@gmail.com>"

# Push notification ke HP via aplikasi ntfy (gratis). Pakai nama topik yang sulit ditebak.
# NTFY_TOPIC = "panitia-kalender-8f3k2q9x"
